# .env.example
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
JWT_KEY=your-long-random-key
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_PLAYLIST_ID=your-youtube-playlist-id
LINE_LOGIN_CLIENT_ID=your-line-client-id
LINE_LOGIN_CLIENT_SECRET=your-line-client-secret
LINE_LOGIN_REDIRECT_URI=http://localhost:7071/api/members/line/callback
FRONTEND_BASE_URL=http://localhost:5173
Passkeys__Enabled=true
# Select smtp, microsoft365, or disabled. No mailbox domain is assumed.
# Supply credentials through deployment secret configuration, never source control.
# IdentityEmail__Provider=smtp
# IdentityEmail__Sender=sender@example.org
# SMTP requires STARTTLS (default port 587); implicit TLS port 465 is not supported.
# Gmail: smtp.gmail.com, port 587, full Gmail address as username, Google app password.
# IdentityEmail__Smtp__Host=smtp.gmail.com
# IdentityEmail__Smtp__Port=587
# IdentityEmail__Smtp__Username=
# IdentityEmail__Smtp__Password=
# Leave BOTH username/password unset only for a STARTTLS relay authorized by deployment IP.
# Optional Microsoft 365 Graph: Provider=microsoft365; restrict Mail.Send to the sender mailbox.
# IdentityEmail__TenantId=
# IdentityEmail__ClientId=
# IdentityEmail__ClientSecret=
# Bind an EXISTING seeded administrator by immutable member ID and an operator-verified mailbox.
# AdministratorActivation__Enabled=false
# AdministratorActivation__MemberId=
# AdministratorActivation__Email=
# Never persist AdministratorActivation__Recover=true; pass it only to an explicit recovery invocation.
Passkeys__RpId=localhost
Passkeys__RpName=ALIFE
Passkeys__Origins__0=http://localhost:5173
TokenProtection__SigningKey=replace-with-at-least-32-random-bytes
RateLimiting__HashKey=replace-with-a-distinct-at-least-32-byte-random-key
TrustedProxyNetworks__0=127.0.0.1/32
AlphaLogin__Enabled=false
# AlphaLogin__Accounts__0__AccountId=local-demo
# AlphaLogin__Accounts__0__MemberId=00000000-0000-0000-0000-000000000000
# AlphaLogin__Accounts__0__Label=Local demo account
# AlphaLogin__PasskeyBootstrapCodes__local-demo=replace-with-at-least-24-random-characters
CADDY_SITE_ADDRESS=localhost
Cloudflare__AccountId=your-cloudflare-account-id
Cloudflare__ZoneId=your-cloudflare-zone-id
Cloudflare__AuthzNamespaceId=your-cloudflare-authz-kv-namespace-id
Cloudflare__ApiCacheNamespaceId=your-cloudflare-api-cache-kv-namespace-id
Cloudflare__ApiToken=your-cloudflare-kv-api-token
Cloudflare__SyncWorkerBaseUrl=https://ccalc.live
Cloudflare__SyncApiToken=your-high-entropy-cache-sync-token
