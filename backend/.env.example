# .env.example
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
JWT_KEY=your-long-random-key

# YouTube
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_PLAYLIST_ID=your-youtube-playlist-id

# LINE Login
LINE_LOGIN_CLIENT_ID=your-line-client-id
LINE_LOGIN_CLIENT_SECRET=your-line-client-secret
LINE_LOGIN_REDIRECT_URI=http://localhost:8080/api/members/line/callback

# Frontend
FRONTEND_BASE_URL=http://localhost:5173

# Caddy
CADDY_SITE_ADDRESS=localhost

# Cloudflare Sync Worker
Cloudflare__SyncWorkerBaseUrl=https://alife-sync-signal.example.workers.dev
Cloudflare__SyncApiToken=replace-with-worker-secret
Push__Subject=mailto:admin@example.com
Push__VapidPublicKey=replace-with-vapid-public-key
Push__VapidPrivateKey=replace-with-vapid-private-key
