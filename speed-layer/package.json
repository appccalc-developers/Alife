{
  "name": "speed-layer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:worker",
    "build:frontend": "cd ../frontend/alife-app && npm run build",
    "build:worker": "mkdir -p ../frontend/alife-app/dist && wrangler deploy --dry-run --outdir dist/app_ccalc",
    "test": "npm run test:worker",
    "test:worker": "npm run build:worker && node --test index.test.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && npx wrangler deploy"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "^4.88.0"
  }
}