{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-ccalc",
  "compatibility_date": "2026-05-06",
  "observability": {
    "enabled": true
  },
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "API_PROXY_TARGET": "https://api.ccalc.live"
  },
  "routes": [
    {
      "pattern": "app.ccalc.live",
      "custom_domain": true
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
