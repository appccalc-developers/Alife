{
  "name": "speed-layer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend && npm run build:worker",
    "build:frontend": "npm install --prefix ../alife-app && npm run build --prefix ../alife-app",
    "build:worker": "wrangler deploy --dry-run --outdir dist/app_ccalc",
    "prepare:deploy-config": "node ./scripts/create-deploy-config.mjs",
    "test": "npm run build && node --test index.test.mjs",
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && npm run prepare:deploy-config && npx wrangler deploy --config .wrangler.deploy.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260607.1",
    "typescript": "~5.9.3",
    "wrangler": "^4.105.0"
  }
}
