{
  "name": "alife-app",
  "private": true,
  "version": "0.1.0",
  "description": "Bilingual React PWA for the Alife community platform.",
  "type": "module",
  "scripts": {
    "generate:project-overview": "node scripts/generate-project-overview.mjs",
    "predev": "npm run generate:project-overview",
    "prebuild": "npm run generate:project-overview",
    "dev": "vite --host",
    "generate:public-home-bootstrap": "node scripts/generate-public-home-bootstrap.mjs",
    "test:group-hierarchy": "node --test --experimental-strip-types tests/groupHierarchy.test.ts",
    "test:church-life": "node --test --experimental-strip-types tests/churchLife.test.ts",
    "test:locale": "node --test --experimental-strip-types tests/locale.test.ts",
    "test:bilingual": "node --test --experimental-strip-types tests/bilingualValidation.test.ts",
    "test:page-bilingual": "node --test --experimental-strip-types tests/pageBilingualCompletion.test.ts",
    "test:article-covers": "node --test --experimental-strip-types tests/articleCover.test.ts",
    "test:navigation-policy": "node --test --experimental-strip-types tests/navigationPolicy.test.ts",
    "test:route-chunk-recovery": "node --test --experimental-strip-types tests/routeChunkRecovery.test.ts tests/virtualChurchPreviewAssetBoundary.test.mjs tests/virtualChurchCacheMaintenance.test.mjs",
    "test:current-tasks": "node --test --experimental-strip-types tests/currentTasks.test.ts",
    "test:event-duties": "node --test --experimental-strip-types tests/currentTasks.test.ts tests/eventDuties.test.ts",
    "test:current-group-selection": "node --test --experimental-strip-types tests/currentGroupSelection.test.ts",
    "test:collection-adapters": "node --test --experimental-strip-types tests/collectionAdapters.test.ts",
    "test:visit-contact": "node --test --experimental-strip-types tests/visitContactValidation.test.ts",
    "test:identity": "node --test --experimental-strip-types tests/identityPathPolicy.test.ts tests/currentTasks.test.ts tests/passkeyErrors.test.ts tests/churchApplicationValidation.test.ts tests/passkeyRequestGuard.test.ts tests/deviceClass.test.ts tests/manualActivationClipboard.test.ts",
    "test:web-dialogs": "node --test --experimental-strip-types tests/webDialogs.test.ts",
    "test:workspace-layout": "node --test --experimental-strip-types tests/workspaceLayout.test.ts",
    "test:event-composition": "node --test --experimental-strip-types tests/eventComposition.test.ts tests/eventCreationDraft.test.ts tests/eventCreationArrangements.test.ts tests/eventSetupFlow.test.ts tests/eventSavedPreparation.test.ts tests/eventDetailsAssistant.test.ts tests/eventFormAssistant.test.ts tests/eventOperations.test.ts tests/eventVenue.test.ts tests/eventTravel.test.ts tests/eventSafeguarding.test.ts tests/eventTemplateAdmin.test.ts tests/eventPackageApproval.test.ts tests/eventPackagePolicyEditor.test.ts tests/ramGovernance.test.ts",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "npm run build && npm --prefix ../speed-layer run dev",
    "profile:3d:serve": "node ../../tools/virtual-church/slow-preview-server.mjs --root=dist --port=4183 --latency-ms=100 --kbps=20000",
    "profile:3d:serve:mobile": "node ../../tools/virtual-church/slow-preview-server.mjs --root=dist --port=4184 --latency-ms=150 --kbps=10000",
    "profile:3d:validate": "node ../../tools/virtual-church/validate-performance-profile.mjs",
    "validate:3d:static-payload": "node ../../tools/virtual-church/validate-static-critical-payload.mjs",
    "validate:3d:loading-boundaries": "node ../../tools/virtual-church/validate-loading-boundaries.mjs",
    "validate:3d:asset-integrity": "node ../../tools/virtual-church/validate-runtime-asset-integrity.mjs",
    "validate:3d:fallback-runtime": "node ../../tools/virtual-church/validate-fallback-runtime.mjs",
    "validate:3d:interaction-runtime": "node ../../tools/virtual-church/validate-interaction-runtime.mjs",
    "validate:3d:accessibility-runtime": "node ../../tools/virtual-church/validate-accessibility-runtime.mjs",
    "validate:3d:status-runtime": "node ../../tools/virtual-church/validate-status-runtime.mjs",
    "validate:3d:recovery-runtime": "node ../../tools/virtual-church/validate-recovery-runtime.mjs",
    "validate:3d:session-runtime": "node ../../tools/virtual-church/validate-session-runtime.mjs",
    "validate:3d:resource-timing": "node ../../tools/virtual-church/validate-resource-timing-runtime.mjs",
    "validate:3d:chunk-closure": "node ../../tools/virtual-church/validate-production-chunk-closure.mjs",
    "validate:3d:http-boundary": "node ../../tools/virtual-church/validate-static-asset-http-boundary.mjs",
    "validate:3d:profile-comparison": "node ../../tools/virtual-church/validate-profile-comparison-runtime.mjs",
    "render:3d:hero-review": "node ../../tools/virtual-church/render-gate-a-hero-review.mjs",
    "render:3d:parking-layout-review": "node ../../tools/virtual-church/render-gate-a-parking-layout-review.mjs",
    "render:3d:faithful-entrance-review": "node ../../tools/virtual-church/render-gate-a-faithful-entrance-review.mjs",
    "render:3d:gate-a-style-slice-review": "node ../../tools/virtual-church/render-gate-a-style-slice-review.mjs",
    "validate:3d:hero-runtime": "node ../../tools/virtual-church/validate-gate-a-animation-runtime.mjs",
    "validate:3d:hero-kinematics": "node ../../tools/virtual-church/validate-gate-a-animation-kinematics.mjs",
    "validate:3d:hero-dcc-source": "node ../../tools/virtual-church/validate-gate-a-hero-dcc-source.mjs",
    "validate:3d:hero-wardrobe": "node ../../tools/virtual-church/validate-gate-a-wardrobe-runtime.mjs",
    "validate:3d:church-baseline": "node ../../tools/virtual-church/validate-gate-a-church-baseline.mjs",
    "validate:3d:entrance-information": "node ../../tools/virtual-church/validate-gate-a-entrance-information.mjs",
    "validate:3d:asset-release": "node ../../tools/virtual-church/validate-asset-release-cache.mjs",
    "validate:3d:asset-release:dist": "node ../../tools/virtual-church/validate-asset-release-cache.mjs --dist",
    "build:3d:church-v3": "node ../../tools/virtual-church/build-gate-a-church-textures.mjs",
    "validate:3d:church-textures": "node ../../tools/virtual-church/build-gate-a-church-textures.mjs --validate",
    "audit:3d:gate-a-readiness": "node ../../tools/virtual-church/audit-gate-a-readiness.mjs",
    "deploy": "npm run build && npm --prefix ../speed-layer run deploy"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/query-db-collection": "1.0.36",
    "@tanstack/react-db": "0.1.83",
    "@tanstack/react-query": "^5.100.9",
    "@tinymce/tinymce-react": "^6.3.0",
    "@youversion/platform-core": "^2.2.0",
    "axios": "^1.13.6",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.40.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "qrcode": "1.5.4",
    "remark-gfm": "^4.0.1",
    "speed-layer": "file:../speed-layer",
    "tailwindcss": "^3.4.19",
    "three": "^0.185.1",
    "tinymce": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "7.4.1"
  }
}
