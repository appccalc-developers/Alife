// .env.example
// Example environment variables for the backend application. Adjust the values as needed for your local development or production environment.
// For security reasons, do not commit your .env file to version control. The .env file should be added to .gitignore.

// Production / `vite build`: browser calls this host directly (the API must allow your frontend origin in CORS when using credentials).
// VITE_API_BASE_URL=https://api.ccalc.live

// `npm run dev` only: Vite proxies /api to this URL. Set this if the API is not at https://api.ccalc.live (optional; that URL is the default in vite.config.ts).
// API_PROXY_TARGET=http://localhost:8080

// `npm run dev` only: Vite proxies /images to this URL. The deployed app uses https://ccalc.live/images.
// IMAGES_PROXY_TARGET=https://images.ccalc.live

// YouVersion Platform App Key. This is required by the official JavaScript SDK in the browser.
// Store the actual value only in .env.local; never commit it.
// VITE_YOUVERSION_APP_KEY=your-app-key
