{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/images/*",
      "/icons/*",
      "/*.{js,mjs,css,json,png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,mp4}"
    ]
  },
  "mimeTypes": {
    ".js": "application/javascript",
    ".mjs": "application/javascript"
  }
}
